# Stock local infrastructure
STOCK_MYSQL_PORT=3306
STOCK_REDIS_PORT=6379

# Auth/Gateway local integration for stock login
AUTH_JWT_SECRET=stock-local-jwt-secret-hs512-minimum-length-64-chars-1234567890
CLOUD_JWT_SECRET=stock-local-jwt-secret-hs512-minimum-length-64-chars-1234567890
AUTH_DB_USERNAME=
AUTH_DB_PASSWORD=
AUTH_MANAGER_SIGNUP_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Stock trading defaults
STOCK_INITIAL_CASH=10000000

# Stock batch jobs
STOCK_BATCH_INTERNAL_TOKEN=local-stock-batch-internal-token
STOCK_BATCH_SERVER_SHUTDOWN=graceful
STOCK_BATCH_SHUTDOWN_TIMEOUT=70s
STOCK_BATCH_SCHEDULING_AWAIT_TERMINATION=true
STOCK_BATCH_SCHEDULING_AWAIT_TERMINATION_PERIOD=60s
STOCK_BATCH_SHUTDOWN_AWAIT_RUNNING_JOBS_SECONDS=60
STOCK_BATCH_MARKET_DATA_PROVIDER=mock
STOCK_BATCH_VIRTUAL_PRICE_EXECUTION_ENABLED=true
STOCK_BATCH_ORDER_BOOK_EXECUTION_ENABLED=true
STOCK_BATCH_SETTLEMENT_CRON=0 40 15 * * MON-FRI
STOCK_BATCH_SETTLEMENT_ZONE=Asia/Seoul
STOCK_PRICE_CACHE_TTL_SECONDS=60

# Gateway-protected internal stock batch route
ZEROQ_GATEWAY_SHARED_SECRET=zeroq-gateway-local-shared-secret
ZEROQ_GATEWAY_ALLOWED_CLOCK_SKEW_SECONDS=300

# Optional KIS market data provider
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_MARKET_DIV_CODE=J

# Stock smoke check defaults
GATEWAY_URL=http://localhost:8080
STOCK_BACK_URL=http://localhost:20480
STOCK_BATCH_URL=http://localhost:20481
EUREKA_URL=http://localhost:8761
STOCK_ACCESS_TOKEN=
STOCK_SMOKE_RUN_BATCH_JOBS=false
STOCK_SMOKE_RUN_GATEWAY_BATCH_JOBS=false
STOCK_SMOKE_GATEWAY_ID=stock-smoke-gateway
STOCK_SMOKE_PLACE_ORDER=false
STOCK_SMOKE_EXPECT_SEEDED_MARKET=false
STOCK_SMOKE_SYMBOL=
STOCK_SMOKE_LIMIT_PRICE=70000
STOCK_SMOKE_QUANTITY=1
STOCK_SMOKE_RUN_ID=
STOCK_SMOKE_CLIENT_ORDER_ID=

# Stock H2 smoke check defaults
STOCK_H2_BACK_URL=http://localhost:30480
STOCK_H2_BATCH_URL=http://localhost:30481
STOCK_H2_BATCH_INTERNAL_PORT=30482
STOCK_H2_BATCH_INTERNAL_URL=http://localhost:30482
STOCK_SMOKE_USER_KEY=h2-smoke-user
STOCK_SMOKE_TIMEOUT_SECONDS=40
STOCK_SMOKE_LOG_DIR=artifacts/stock-h2-smoke

# Stock auth/gateway H2 smoke check defaults
STOCK_AUTH_SMOKE_LOG_DIR=artifacts/stock-auth-h2-smoke
STOCK_AUTH_SMOKE_TIMEOUT_SECONDS=90
STOCK_AUTH_SMOKE_USER=
STOCK_AUTH_SMOKE_PASSWORD=stock-auth-smoke-password
STOCK_AUTH_SMOKE_EMAIL=
STOCK_AUTH_SMOKE_JWT_SECRET=stock-auth-h2-smoke-jwt-secret-hs512-minimum-length-64-chars-1234567890

# Stock gateway H2 smoke check defaults
STOCK_GATEWAY_H2_LOG_DIR=artifacts/stock-gateway-h2-smoke
STOCK_GATEWAY_H2_TIMEOUT_SECONDS=90
STOCK_GATEWAY_H2_JWT_SECRET=stock-gateway-h2-smoke-jwt-secret-hs512-minimum-length-64-chars-1234567890
STOCK_GATEWAY_H2_BATCH_TOKEN=stock-gateway-h2-smoke-internal-token
STOCK_GATEWAY_H2_SHARED_SECRET=stock-gateway-h2-smoke-shared-secret
STOCK_GATEWAY_H2_USER=
STOCK_GATEWAY_H2_PASSWORD=stock-gateway-h2-password
STOCK_GATEWAY_H2_EMAIL=
